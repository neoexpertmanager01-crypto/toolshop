{
  "id": null,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Rate — скільки запитів за секунду обробляє сервіс.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(http_requests_total{service=\"demo-app\"}[$__rate_interval]))",
          "legendFormat": "RPS",
          "refId": "A"
        }
      ],
      "title": "Requests per second (demo-app)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Errors — частка відповідей 5xx від усіх запитів.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "100 * sum(rate(http_requests_total{service=\"demo-app\",status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_requests_total{service=\"demo-app\"}[$__rate_interval]))",
          "legendFormat": "5xx %",
          "refId": "A"
        }
      ],
      "title": "Error rate, % 5xx (demo-app)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Duration — 95-й перцентиль тривалості запиту.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_ms_bucket{service=\"demo-app\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "title": "Latency p95, ms (demo-app)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "description": "Логи з Loki: лише записи рівня error (pino level 50) сервісу demo-app.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{service=\"demo-app\"} | json | line_format \"{{.body}}\" | json | level >= 50 | line_format \"[{{.flow}}] {{.msg}}: {{.err_message}} (trace {{.trace_id}})\"",
          "refId": "A"
        }
      ],
      "title": "Error logs (demo-app, level ≥ 50)",
      "type": "logs"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "red",
    "demo-app",
    "toolshop-course"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "My Demo RED",
  "uid": "my-demo-red",
  "version": 2
}